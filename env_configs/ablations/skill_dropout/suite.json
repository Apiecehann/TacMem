  "launch": {
    "cwd": "repository root",
    "entrypoint": "capx.envs.launch",
    "inline_bootstrap": "import json\nfrom pathlib import Path\nfrom capx.envs import launch\noriginal_loader=launch._load_config\ndef configured_loader(args):\n    result=original_loader(args)\n    args.model_timeout_seconds=600\n    p=Path(args.request_log_dir).parent/'protocol.json'\n    data=json.loads(p.read_text());data['model_timeout_seconds']=args.model_timeout_seconds\n    p.write_text(json.dumps(data,ensure_ascii=False,indent=2))\n    print('MODEL_REQUEST_TIMEOUT_SECONDS='+str(args.model_timeout_seconds),flush=True)\n    return result\nlaunch._load_config=configured_loader\nlaunch.main(launch.tyro.cli(launch.LaunchArgs))\n",
    "argv": [
      "${CAPX_BASELINE_PYTHON}",
      "-c",
      "<inline_bootstrap>",
      "--config-path",
      "<groups[condition][task].config>"
    ],
    "per_episode_environment": {
      "CAPX_TASK_SEED": "<seed>",
      "GPU": "<explicit physical GPU index>",
      "CAPX_TACEX_RUNTIME_ROOT": "<task_backing_root>/third_party/TacEx"
    },
    "sequential": true,
    "gpu_policy": "Check the explicitly selected GPU before each attempt; pause if busy; do not automatically switch",
    "proxy_policy": "Remove HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY and lowercase forms from client and simulator",
    "simulator_umask": "0022",
    "environment_paths": "Discover local paths; do not copy paths from another machine",
    "required_environment": [
      "CAPX_BASELINE_PYTHON",
      "CAPX_SIM_PYTHON",
      "CAPX_SIM_HTTP_DEPS",
      "CAPX_API_KEY",
      "CAPX_MODEL_URL",
      "CAPX_ABLATION_OUTPUT_DIR",
      "GPU",
      "UNIVTAC_PORT",
      "UNIVTAC_SERVER_URL",
      "UNIVTAC_ROOT",
      "VITAFORGE_ROOT",
      "UNIVTAC_COMPOSABLE_ROOT"
    ],
    "backing_roots": {
      "tactile_memory_match": "UNIVTAC_COMPOSABLE_ROOT",
      "tension_strap": "VITAFORGE_ROOT",
      "bulb_tightening": "VITAFORGE_ROOT",
      "blind_pick_balls": "UNIVTAC_ROOT"
    },
    "environment_binding": "UNIVTAC_ROOT and VITAFORGE_ROOT point to the same compatible OpenTacBench checkout; combination uses the existing composable checkout",
    "dependency_check": "Verify uvicorn.Config(FastAPI()).load() with CAPX_SIM_PYTHON and CAPX_SIM_HTTP_DEPS before GPU startup; package import alone does not verify WebSocket modules",
    "compatibility": {
      "blind_pick_balls": "UNIVTAC_BLIND_LEGACY_PHYSX=1 for the verified Isaac Sim 4.5 environment",
      "tactile_memory_match": "CAPX_MEMORY_MATCH_LIVE_GRASP=1; use the current compact native builder without the obsolete compact_fixed_pair_scene override"
    }
  },
