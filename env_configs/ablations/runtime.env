export CAPX_BASELINE_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd -P)"
export CAPX_BASELINE_PYTHON=/mnt/data/ljz/opentacbench/cap-agent0-baselines/client-env/bin/python
export CAPX_SIM_HTTP_DEPS=/mnt/data/ljz/opentacbench/cap-agent0-baselines/server-http-overlay:/mnt/data/ljz/opentacbench/ablation-http-deps
export UNIVTAC_ROOT=/mnt/a/ljz/cap/OpenTacBench
export VITAFORGE_ROOT="$UNIVTAC_ROOT"
export TACEX_RUNTIME_ROOT="$UNIVTAC_ROOT/third_party/TacEx"
export PYTHONPATH="$CAPX_BASELINE_ROOT"
export PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1
export TMPDIR=/mnt/data/ljz/opentacbench/cap-agent0-baselines/tmp
export HF_HOME=/mnt/data/ljz/opentacbench/cap-agent0-baselines/cache/huggingface
export XDG_CACHE_HOME=/mnt/data/ljz/opentacbench/cap-agent0-baselines/cache
export TORCH_EXTENSIONS_DIR=/mnt/data/ljz/opentacbench/cap-agent0-baselines/cache/torch_extensions
unset http_proxy https_proxy all_proxy no_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
mkdir -p "$TMPDIR"
