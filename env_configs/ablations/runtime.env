# Source after activating the existing UniVTAC environment. No secret values.
# Reuse Kit's shipped HTTP dependencies; do not pip-upgrade the simulation env.
export CAPX_BASELINE_ROOT=/mnt/data/ljz/opentacbench/cap-tac-baselines
export CAPX_BASELINE_PYTHON=/mnt/data/ljz/opentacbench/conda-envs/UniVTAC/bin/python
export CAPX_KIT_HTTP_DEPS=/mnt/data/ljz/opentacbench/ablation-http-deps
export PYTHONPATH="$CAPX_BASELINE_ROOT:$CAPX_KIT_HTTP_DEPS"
export CAPX_BASELINE_ONLY=1 PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1
export TMPDIR=/mnt/data/ljz/opentacbench/ablation-cpu-tests
